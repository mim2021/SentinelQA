# Copy to .env (never commit .env). Values below are placeholders.
DISCORD_TOKEN=replace-with-discord-bot-token
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me
TRUSTGUARD_MOD_CHANNEL_ID=000000000000000000
TRUSTGUARD_HOLD_ROLE_ID=
TRUSTGUARD_TRUSTED_DOMAINS=example-internal.com,example.com
# Optional: SQLite file that keeps bans, approvals and lockdown across restarts (no message content).
TRUSTGUARD_STATE_PATH=trustguard-state.db
# Optional score thresholds (defaults 35 / 60). Raise QUARANTINE_AT during a pilot to warn only.
TRUSTGUARD_WARN_AT=35
TRUSTGUARD_QUARANTINE_AT=60
# Slack: user ids (besides workspace admins/owners) allowed to run !tg commands, comma-separated.
TRUSTGUARD_ADMIN_IDS=
# Slack: set to 1 to remove held people from protected channels (needs channels:manage, groups:write).
TRUSTGUARD_SLACK_REMOVE_HELD=0
