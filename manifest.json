{
  "manifest_version": 3,
  "name": "SentinelQA",
  "version": "0.5.0",
  "description": "Runs automated security health-checks on websites and shows a report card.",
  "permissions": ["storage", "activeTab", "tabs", "webRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib/rules.js", "lib/core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
